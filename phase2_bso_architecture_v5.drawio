  <diagram id="phase2-bso-v5" name="Phase 2 - BSO Architecture v5">
    <mxGraphModel dx="2000" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Phase 2 — Balance Sheet Optimization Agent Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="600" y="20" width="800" height="40" as="geometry" />
        </mxCell>

        <!-- Phase 1 input -->
        <mxCell id="phase1" value="Phase 1 Output&#10;(Macro Strategy)&#10;&#10;e.g. &quot;Interest rates&#10;expected to drop&quot;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="80" y="320" width="200" height="100" as="geometry" />
        </mxCell>

        <!-- Final output -->
        <mxCell id="output" value="Approved Balance Sheet&#10;Adjustment Plan" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1720" y="325" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- BSO - purple, distinct level -->
        <mxCell id="bso" value="BSO&#10;(Balance Sheet Orchestrator)&#10;&#10;• Receives macro strategy from Phase 1&#10;• Decomposes into sub-strategies&#10;• Dispatches tasks to sub-agents&#10;• Consolidates proposals&#10;• Invokes Optimization Agent if needed&#10;• Evaluates vs. current baseline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;fontStyle=1;arcSize=10;align=center;verticalAlign=middle;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="800" y="270" width="400" height="200" as="geometry" />
        </mxCell>

        <!-- Sub-agents layer label -->
        <mxCell id="subagent_label" value="Sub-Agents (orchestrated by BSO)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=2;fontColor=#666666" vertex="1" parent="1">
          <mxGeometry x="700" y="650" width="600" height="20" as="geometry" />
        </mxCell>

        <!-- Sub-agents row -->
        <mxCell id="fd_proposer" value="FD Proposer&#10;&#10;Optimizes Fixed Deposit&#10;structure per BSO directive&#10;&#10;e.g. shift 1Y deposits → ≤3M&#10;as they mature" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;arcSize=10" vertex="1" parent="1">
          <mxGeometry x="80" y="700" width="240" height="140" as="geometry" />
        </mxCell>

        <mxCell id="loan_proposer" value="Loan Proposer&#10;&#10;Optimizes Loan structure&#10;per BSO directive&#10;&#10;e.g. extend short-term loans&#10;to lock in current high rates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;arcSize=10" vertex="1" parent="1">
          <mxGeometry x="420" y="700" width="240" height="140" as="geometry" />
        </mxCell>

        <mxCell id="casa_proposer" value="CASA Proposer&#10;&#10;Optimizes CASA (Current &amp;&#10;Savings Account) structure&#10;per BSO directive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;arcSize=10" vertex="1" parent="1">
          <mxGeometry x="760" y="700" width="240" height="140" as="geometry" />
        </mxCell>

        <mxCell id="analytics_agent" value="Analytics Agent&#10;&#10;Performs ad-hoc analytics&#10;(e.g. for ALCO meetings):&#10;metrics computation,&#10;trend analysis, reporting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;arcSize=10" vertex="1" parent="1">
