        </mxCell>

        <mxCell id="optimization_agent" value="Optimization Agent&#10;&#10;Fine-tunes consolidated&#10;proposals across FD / Loan /&#10;CASA to maximize NIM under&#10;global constraints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;arcSize=10" vertex="1" parent="1">
          <mxGeometry x="1440" y="700" width="240" height="140" as="geometry" />
